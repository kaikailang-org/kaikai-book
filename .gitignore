# macOS
.DS_Store
**/.DS_Store

# Build artifacts (PDF + intermediate files)
borradores/build-pdf/*.pdf
borradores/build-pdf/body*.md
borradores/build-pdf/body*.typ
borradores/build-pdf/kaikai-libro-es.typ
borradores/build-pdf/kaikai-book-en.typ
borradores/build-pdf/figuras/

# Compiled example binaries and runtime logs (kai build/run output)
# `kai build <file.kai>` drops a name-stripped Mach-O next to the cwd;
# when run from the repo root that lands here, so ignore loose ones.
/[0-9][0-9]_*
!/[0-9][0-9]_*.kai
ejemplos/**/main
examples/**/main
ejemplos/cap17/notas/notas
ejemplos/cap17/notas/*.log
ejemplos/cap18/ledger/ledger
examples/ch17/notes/notes
examples/ch18/ledger/ledger
