# Property-based: declaras una invariante y el runner la
# verifica con valores generados al azar.
#
# Correr con: kai check ejemplos/cap07/03_check_propiedades.kai

fn doble(n: Int) : Int = n * 2

# Una propiedad sobre un solo Int.
check "doble es par" with n: Int {
  doble(n) % 2 == 0
}

# La suma es conmutativa para cualquier par de Int.
check "suma conmutativa" with a: Int, b: Int {
  a + b == b + a
}

# La suma es asociativa para cualquier triple.
check "suma asociativa" with a: Int, b: Int, c: Int {
  (a + b) + c == a + (b + c)
}

# Sobre listas: invertir dos veces es identidad.
check "reverse de reverse" with xs: [Int] {
  list.reverse(list.reverse(xs)) == xs
}
