## Un shim C que vive en este directorio. Compila con:
##
##   $ CFLAGS="-include shim.h shim.c" \
##       kai build --backend=c app.kai -o app
##   $ ./app
##   doble(21) = 42

extern "C" fn my_double(x: Int) : Int / Ffi

fn main() : Unit / Console + Ffi {
  print("doble(21) = #{my_double(21)}")
}
