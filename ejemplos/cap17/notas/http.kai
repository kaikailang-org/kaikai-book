# Parser y serializador HTTP mínimos. Cubrimos lo justo para
# servir requests sencillos. Para producción real se usaría el
# parser de stdlib/net/http.kai; acá lo escribimos a mano para
# que la cadena completa quepa en la cabeza del lector.

import dominio

#derive(Show)
pub type ReqHttp = { metodo: String, path: String, cuerpo: String }

pub fn parsear_request(raw: String) : Result[String, ReqHttp] {
  match string.split(raw, "\r\n\r\n") {
    [head, ...cuerpo_partes] -> {
      let cuerpo = string.join(cuerpo_partes, "\r\n\r\n")
      match string.split(head, "\r\n") {
        [primera, ..._] -> parsear_primera_linea(primera, cuerpo)
        []              -> Err("request vacío")
      }
    }
    _ -> Err("request sin separador de headers")
  }
}

fn parsear_primera_linea(linea: String, cuerpo: String) : Result[String, ReqHttp] {
  match string.split(linea, " ") {
    [metodo, path, ..._] -> Ok(ReqHttp { metodo: metodo, path: path, cuerpo: cuerpo })
    _                     -> Err("primera línea malformada: '#{linea}'")
  }
}

# Traduce un ReqHttp en un Comando del dominio. Si la URL no
# calza con ninguna ruta, devuelve una Respuesta inmediata.
pub fn enrutar(req: ReqHttp) : Result[dominio.Respuesta, dominio.Comando] {
  if req.metodo == "GET" {
    if req.path == "/notas" {
      Ok(dominio.Listar)
    } else {
      enrutar_id(req.path, (id) => dominio.Obtener(id))
    }
  } else if req.metodo == "POST" {
    if req.path == "/notas" {
      Ok(dominio.Crear(req.cuerpo))
    } else {
      Err(dominio.NoEncontrado)
    }
  } else if req.metodo == "DELETE" {
    enrutar_id(req.path, (id) => dominio.Borrar(id))
  } else {
    Err(dominio.NoEncontrado)
  }
}

fn enrutar_id(path: String, f: (Int) -> dominio.Comando) : Result[dominio.Respuesta, dominio.Comando] {
  if string.starts_with(path, "/notas/") {
    let sin_prefijo = string.drop_prefix(path, "/notas/")
    match int.parse(sin_prefijo) {
      Some(n) -> Ok(f(n))
      None    -> Err(dominio.ErrorCliente("id inválido en path: '#{path}'"))
    }
  } else {
    Err(dominio.NoEncontrado)
  }
}

# Serializa una respuesta del dominio en bytes HTTP.
pub fn serializar_respuesta(r: dominio.Respuesta) : String {
  match r {
    dominio.Ok(body)            -> respuesta(200, "OK", body)
    dominio.Creado(nota)        -> respuesta(201, "Created", "#{nota}")
    dominio.NoEncontrado         -> respuesta(404, "Not Found", "")
    dominio.ErrorCliente(msg)   -> respuesta(400, "Bad Request", msg)
    dominio.ErrorServidor(msg)  -> respuesta(500, "Internal Error", msg)
  }
}

fn respuesta(status: Int, reason: String, body: String) : String {
  let largo = string.length(body)
  "HTTP/1.1 #{status} #{reason}\r\nContent-Length: #{largo}\r\nContent-Type: text/plain\r\n\r\n#{body}"
}

test "parsear GET /notas" {
  let raw = "GET /notas HTTP/1.1\r\nHost: x\r\n\r\n"
  let ok = match parsear_request(raw) {
    Ok(r)  -> r.metodo == "GET" and r.path == "/notas"
    Err(_) -> false
  }
  assert ok
}

test "enrutar POST /notas" {
  let req = ReqHttp { metodo: "POST", path: "/notas", cuerpo: "hola" }
  let ok = match enrutar(req) {
    Ok(dominio.Crear(c)) -> c == "hola"
    _                     -> false
  }
  assert ok
}
