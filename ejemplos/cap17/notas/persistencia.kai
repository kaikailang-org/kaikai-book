# El actor de persistencia recibe cada nota creada o borrada y
# la escribe a un archivo de log. En un sistema real, el
# mailbox sería `Bounded(1024, DropOldest)` para que el log
# nunca infle la memoria si la escritura a disco se atrasa.
# Acá usamos `spawn_actor` (mailbox Unbounded por default)
# porque para el demo alcanza.

import actor
import fs.file

pub type Evento = Linea(String)

fn bucle(path: String) : Unit / Actor[Evento] + File {
  match Actor.receive() {
    Linea(s) -> {
      file.file_append(path, s ++ "\n")
      bucle(path)
    }
  }
}

pub fn arrancar(path: String)
    : Pid[Evento] / Spawn + Cancel + Actor[Evento] + File {
  # Truncamos el archivo al arrancar y empezamos limpio.
  file.file_write_file(path, "")
  spawn_actor(() => bucle(path))
}
