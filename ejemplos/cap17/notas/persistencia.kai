# El actor de persistencia recibe líneas de log y las anexa a
# un archivo. Aislar la escritura a disco en su propio actor
# permite que el almacén siga respondiendo sin esperar a I/O.

import fs.file

pub type Evento = Linea(String)

# Cuerpo del actor. Anexa cada línea y se llama recursivamente
# a la espera del próximo evento.
pub fn persistencia_loop(path: String) : Unit / Actor[Evento] + File {
  match Actor.receive() {
    Linea(s) -> match file.append(path, s ++ "\n") {
      Ok(_) -> persistencia_loop(path)
      Err(e) -> panic("no pude escribir el log: " ++ e)
    }
  }
}

# Trunca el archivo de log antes de arrancar el actor para que
# cada corrida empiece con un log vacío.
pub fn reset_log(path: String) : Unit / File {
  match file.write(path, "") {
    Ok(_) -> ()
    Err(e) -> panic("no pude truncar el log: " ++ e)
  }
}
