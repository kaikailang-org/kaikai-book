# Parser y serializador HTTP mínimos para el servidor de
# notas. Manipulación pura de strings — sin efectos. Para
# producción real se usaría el parser de `stdlib/net/http.kai`;
# acá lo escribimos a mano para que la cadena completa quepa
# en la cabeza del lector.

import dominio

#[derive(Show)]
pub type ReqHttp = { metodo: String, path: String, cuerpo: String }

# Conversiones bytes ⇄ String para los buffers que devuelve y
# acepta `NetTcp`. Inline para que toda la cadena quepa en la
# cabeza del lector, sin depender de `net.http`.
fn string_to_bytes_loop(s: String, i: Int, n: Int, acc: [Int]) : [Int] =
  if i >= n { list_reverse(acc) }
  else { match char_at(s, i) {
    Some(c) -> string_to_bytes_loop(s, i + 1, n, [char_to_int(c), ...acc])
    None    -> list_reverse(acc)
  } }

pub fn string_to_bytes(s: String) : [Int] =
  string_to_bytes_loop(s, 0, string_length(s), [])

fn byte_to_str(b: Int) : String = "#{int_to_char(b)}"

pub fn bytes_to_string(bs: [Int]) : String =
  string_concat_all(list.map(bs, byte_to_str))

pub fn parsear_request(raw: String) : Result[String, ReqHttp] = {
  match string.split(raw, "\r\n\r\n") {
    [head, ...cuerpo_partes] -> {
      let cuerpo = string.join(cuerpo_partes, "\r\n\r\n")
      match string.split(head, "\r\n") {
        [primera, ..._] -> parsear_primera_linea(primera, cuerpo)
        []              -> Err("request vacío")
      }
    }
    _ -> Err("request sin separador de headers")
  }
}

fn parsear_primera_linea(linea: String, cuerpo: String) : Result[String, ReqHttp] = {
  match string.split(linea, " ") {
    [metodo, path, ..._] -> Ok(ReqHttp { metodo: metodo, path: path, cuerpo: cuerpo })
    _                     -> Err("primera línea mal formada: '#{linea}'")
  }
}

# Traduce un ReqHttp a un Comando de dominio. Si la URL no
# matchea ninguna ruta, devuelve una respuesta inmediata.
pub fn enrutar(req: ReqHttp) : Result[dominio.Respuesta, dominio.Comando] = {
  if req.metodo == "GET" {
    if req.path == "/notas" {
      Ok(dominio.Listar)
    } else {
      enrutar_id(req.path, (n) => dominio.Obtener(n))
    }
  } else if req.metodo == "POST" {
    if req.path == "/notas" {
      Ok(dominio.Crear(req.cuerpo))
    } else {
      Err(dominio.NoEncontrado)
    }
  } else if req.metodo == "DELETE" {
    enrutar_id(req.path, (n) => dominio.Borrar(n))
  } else {
    Err(dominio.NoEncontrado)
  }
}

fn drop_prefix(s: String, prefix: String) : String = {
  let n = string.length(prefix)
  string.slice(s, n, string.length(s) - n)
}

fn enrutar_id(path: String, f: (Int) -> dominio.Comando) : Result[dominio.Respuesta, dominio.Comando] = {
  if string.starts_with(path, "/notas/") {
    let sufijo = drop_prefix(path, "/notas/")
    match string.to_int(sufijo) {
      Some(n) -> Ok(f(n))
      None    -> Err(dominio.ErrorCliente("id inválido en path: '#{path}'"))
    }
  } else {
    Err(dominio.NoEncontrado)
  }
}

# Serializa una Respuesta de dominio a bytes HTTP.
pub fn serializar_respuesta(r: dominio.Respuesta) : String = match r {
  dominio.Guardado(cuerpo) -> respuesta(200, "OK", cuerpo)
  dominio.Creado(nota)     -> respuesta(201, "Created", "#{nota}")
  dominio.NoEncontrado     -> respuesta(404, "Not Found", "")
  dominio.ErrorCliente(m)  -> respuesta(400, "Bad Request", m)
  dominio.ErrorServidor(m) -> respuesta(500, "Internal Error", m)
}

fn respuesta(status: Int, razon: String, cuerpo: String) : String = {
  let len = string.length(cuerpo)
  "HTTP/1.1 #{status} #{razon}\r\nContent-Length: #{len}\r\nContent-Type: text/plain\r\n\r\n#{cuerpo}"
}

test "parsear GET /notas" {
  let raw = "GET /notas HTTP/1.1\r\nHost: x\r\n\r\n"
  let ok = match parsear_request(raw) {
    Ok(r)  -> r.metodo == "GET" and r.path == "/notas"
    Err(_) -> false
  }
  assert ok
}

test "enrutar POST /notas" {
  let req = ReqHttp { metodo: "POST", path: "/notas", cuerpo: "hola" }
  let ok = match enrutar(req) {
    Ok(dominio.Crear(c)) -> c == "hola"
    _                     -> false
  }
  assert ok
}
