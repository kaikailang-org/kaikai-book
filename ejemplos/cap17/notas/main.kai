# Servidor HTTP de notas. Cablea todas las piezas.
#
# Tres notas estructurales:
#
#   1. `nursery { n -> ... }` es un cap binder sintáctico.
#      `n` no es un valor de tipo `Nursery`; la pasada previa
#      al typechecker reescribe `n.spawn(task)` en
#      `Spawn.spawn(task)` etiquetado con el brand del
#      nursery. Esto significa que la llamada a spawn debe
#      aparecer léxicamente dentro del bloque del nursery; no
#      podemos factorizar el bucle accept a una función libre
#      que reciba `n` como parámetro.
#
#   2. `Actor[t]` no tiene un handler default a nivel `main`.
#      Toda fibra que llama `Actor.send` / `Actor.receive`
#      debe correr bajo su propio `with_mailbox` (o
#      `spawn_actor`): un buzón nunca cruza un spawn. `main`
#      no envía ni recibe, así que no instala ninguno; cada
#      fibra de conexión instala el suyo.
#
#   3. `Pid[t]` está branded por la región del nursery que
#      tiene el handler de Spawn. Por eso spawn-eamos los dos
#      actores *dentro* del bloque `nursery { n -> ... }` y
#      usamos sus pids desde el mismo bloque.

import actor
import spawn
import loop
import net.tcp
import dominio
import almacen
import persistencia
import web

const PUERTO : Int = 8080

const PATH_LOG : String = "notas.log"

# Arma la respuesta de cable para un request HTTP. Le pega al
# almacén vía `almacen.preguntar` y loguea los comandos
# mutantes al actor de persistencia antes de responder.
fn manejar_request(
  raw: String,
  almacen_pid: Pid[almacen.AlmacenMsg],
  log_pid: Pid[persistencia.Evento]
) : String / Actor[almacen.AlmacenResp] {
  let resp = match web.parsear_request(raw) {
    Err(msg) -> dominio.ErrorCliente(msg)
    Ok(req) -> match web.enrutar(req) {
      Err(r) -> r
      Ok(comando) -> {
        registrar(log_pid, comando)
        almacen.preguntar(almacen_pid, comando)
      }
    }
  }
  web.serializar_respuesta(resp)
}

fn registrar[m](log_pid: Pid[persistencia.Evento], c: dominio.Comando) : Unit / Actor[m] = match c {
  dominio.Crear(cuerpo) -> Actor.send(log_pid, persistencia.Linea("CREAR " ++ cuerpo))
  dominio.Borrar(id) -> Actor.send(log_pid, persistencia.Linea("BORRAR #{id}"))
  _ -> ()
}

fn leer_request(conn: Conn) : String / NetTcp = match NetTcp.recv(conn, 4096) {
  Ok(bytes) -> web.bytes_to_string(bytes)
  Err(_) -> ""
}

# Atiende una conexión de punta a punta. Se spawn-ea bajo el
# nursery en `main`; la fibra llamante instalará su propio
# mailbox Actor[AlmacenResp] vía `with_mailbox` para que el
# `almacen.preguntar` sincrónico dentro de `manejar_request`
# aterrice la respuesta en el mailbox de esta fibra.
#
# La fila lleva solo ese buzón. Los envíos al almacén y a
# persistencia pasan por él: una fibra nunca usa el buzón de
# otra.
fn atender_conexion(
  conn: Conn,
  almacen_pid: Pid[almacen.AlmacenMsg],
  log_pid: Pid[persistencia.Evento]
) : Unit / NetTcp + Actor[almacen.AlmacenResp] + Cancel {
  let raw = leer_request(conn)
  let wire = manejar_request(raw, almacen_pid, log_pid)
  let _ = NetTcp.send(conn, web.string_to_bytes(wire))
  NetTcp.close(conn)
}

fn main() : Int / Stdout + NetTcp + File + Spawn + Cancel {
  persistencia.reset_log(PATH_LOG)
  nursery { n ->
    let almacen_body: () -> Unit / Actor[almacen.AlmacenMsg] = () => almacen.almacen_loop([], 1)
    let log_body: () -> Unit / Actor[persistencia.Evento] + File =
      () => persistencia.persistencia_loop(PATH_LOG)
    let almacen_pid = spawn_actor(almacen_body)
    let log_pid = spawn_actor(log_body)
    match NetTcp.listen("0.0.0.0", PUERTO) {
      Err(msg) -> println("error al arrancar el servidor: " ++ msg)
      Ok(listener) -> {
        println("servidor escuchando en puerto #{PUERTO}")
        # Bucle accept: cada conexión se vuelve una fibra
        # hija spawn-eada vía el cap `n` del nursery. El
        # closure captura `n`, `almacen_pid` y `log_pid`
        # del scope del nursery que lo rodea.
        forever(
          () => match NetTcp.accept(listener) {
            Err(_) -> ()
            Ok(conn) -> {
              # Cada fibra de conexión instala su propio
              # mailbox Actor[AlmacenResp] para recibir la
              # respuesta del almacén (ver `atender_conexion`).
              let _ =
                n.spawn(() => with_mailbox(() => atender_conexion(conn, almacen_pid, log_pid)))
              ()
            }
          }
        )
      }
    }
  }

  0
}
