# Tipos de dominio del servidor de notas.
#
# Una nota tiene un id (entero) y un cuerpo (string).
# Un comando es lo que el handler interpreta de un request
# HTTP. Una respuesta es lo que el handler devuelve para que
# se serialice. Sin efectos: este módulo es el invariante del
# programa.

#[derive(Show)]
pub type Nota = { id: Int, cuerpo: String }

# Comandos que el servidor entiende.
pub type Comando
  = Listar
  | Obtener(Int)
  | Crear(String)
  | Borrar(Int)

# Respuestas del nivel de dominio. La variante "ok" se llama
# `Guardado` (no `Ok`) para no colisionar con `Result.Ok` en
# los matches del capítulo. El traductor a HTTP las convierte
# en status codes + cuerpos.
pub type Respuesta
  = Guardado(String)                # 200, body = String
  | Creado(Nota)                    # 201, body = nota serializada
  | NoEncontrado                    # 404
  | ErrorCliente(String)            # 400
  | ErrorServidor(String)           # 500
