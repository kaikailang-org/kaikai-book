# Un hole puede ser el cuerpo de un brazo: el match ya cubre
# todos los constructores y solo falta la expresión. Útil
# cuando sabes qué caso falta pero todavía no decidiste cómo
# manejarlo.

type Forma
  = Circulo(Real)
  | Cuadrado(Real)
  | Triangulo(Real, Real)

fn area(f: Forma) : Real {
  match f {
    Circulo(r) -> 3.14 * r * r
    Cuadrado(l) -> l * l
    Triangulo(b, h) -> ?formula_triangulo
  }
}

fn main() : Unit / Stdout {
  println("círculo 3 -> #{area(Circulo(3.0))}")
  println("cuadrado 4 -> #{area(Cuadrado(4.0))}")
}
