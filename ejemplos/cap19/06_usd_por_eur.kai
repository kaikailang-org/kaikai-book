# Este archivo NO compila, a propósito: el kind Currency no tiene
# producto de habitantes, así que "dólares por euros" es un tipo
# que no se puede formar.

import money
import decimal as dec
import decimal_proto

fn main() : Unit / Stdout = {
  let u: Money[USD] = 10.00<USD>
  let e: Money[EUR] = 5.00<EUR>
  let sinsentido = u * e          # error: `EUR USD` no existe
  println(money.to_string(sinsentido))
}
