# El kind Dim: un índice de shape estático viaja en el tipo.
# `Vec[t]<n>` fija el largo en `n`, un valor de Int escrito en
# `<>`. Un literal de largo distinto no compila; el índice se
# borra en runtime.

# Genérica sobre el largo: `n` es un habitante de Dim, así que
# `punto` acepta un vector de cualquier tamaño.
fn punto[n: Dim](v: Vec[Real]<n>) : Real = v[0]

# Producto punto de dos vectores del MISMO largo `n`. El tipo
# obliga a que coincidan: pasar un <2> y un <3> no compila.
fn dot[n: Dim](a: Vec[Real]<n>, b: Vec[Real]<n>, i: Int, acc: Real) : Real =
  if i < 0 { acc } else { dot(a, b, i - 1, acc + a[i] * b[i]) }

fn main() : Unit / Stdout = {
  let u : Vec[Real]<3> = [1.0, 2.0, 3.0]
  let w : Vec[Real]<3> = [4.0, 5.0, 6.0]
  println(real_to_string(punto(u)))            # 1.0
  println(real_to_string(dot(u, w, 2, 0.0)))   # 1·4 + 2·5 + 3·6 = 32
}
