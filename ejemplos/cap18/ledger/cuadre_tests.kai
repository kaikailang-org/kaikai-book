# Tests de cuadre. Archivo aparte para esquivar el bug del typer
# en kaikai 0.74.0 (ver almacen_tests.kai).

import cuadre
import dominio

test "cuadra con una entrada y una salida" {
  let ms = [
    dominio.Debito(1<dominio.CuentaId>, 100.0<dominio.USD>),
    dominio.Credito(2<dominio.CuentaId>, 100.0<dominio.USD>),
  ]
  assert cuadre.esta_cuadrada(ms)
}

test "no cuadra cuando los montos difieren" {
  let ms = [
    dominio.Debito(1<dominio.CuentaId>, 100.0<dominio.USD>),
    dominio.Credito(2<dominio.CuentaId>, 90.0<dominio.USD>),
  ]
  assert not cuadre.esta_cuadrada(ms)
}

test "cuadra con múltiples líneas" {
  let ms = [
    dominio.Debito(1<dominio.CuentaId>, 60.0<dominio.USD>),
    dominio.Debito(2<dominio.CuentaId>, 40.0<dominio.USD>),
    dominio.Credito(3<dominio.CuentaId>, 100.0<dominio.USD>),
  ]
  assert cuadre.esta_cuadrada(ms)
}
