# Tests del almacén. En archivo aparte para esquivar el bug del
# typer en kaikai 0.74.0: bloques `test "..."` directos en
# `almacen.kai` rompen la resolución de exports cuando `main.kai`
# carga otro módulo local (`cuadre`). `main.kai` no importa este
# archivo; `kai test` lo recoge igual cuando se corre sobre el
# proyecto completo.

import almacen
import dominio

test "crear cuenta la agrega al estado" {
  let (r, s2) = almacen.procesar(dominio.CrearCuenta("caja"), almacen.estado_inicial())
  let ok = match r {
    dominio.CuentaCreada(c) -> c.nombre == "caja"
    _                        -> false
  }
  assert ok
  assert list.length(s2.cuentas) == 1
}

test "registrar transacción descuadrada falla" {
  let s = almacen.Estado {
    cuentas:        [dominio.Cuenta { id: 1<dominio.CuentaId>, nombre: "a", saldo: 0.0<dominio.USD> }],
    transacciones:  [],
    proxima_cuenta: 2<dominio.CuentaId>,
    proxima_tx:     1<dominio.TransaccionId>,
  }
  let movs = [dominio.Debito(1<dominio.CuentaId>, 100.0<dominio.USD>)]   # solo débito, no cuadra
  let (r, _) = almacen.procesar(dominio.Registrar("test", movs), s)
  let ok = match r {
    dominio.ErrorDescuadre(_) -> true
    _                          -> false
  }
  assert ok
}

test "registrar transacción que cuadra actualiza saldos" {
  let s = almacen.Estado {
    cuentas: [
      dominio.Cuenta { id: 1<dominio.CuentaId>, nombre: "caja",   saldo: 0.0<dominio.USD> },
      dominio.Cuenta { id: 2<dominio.CuentaId>, nombre: "ventas", saldo: 0.0<dominio.USD> },
    ],
    transacciones:  [],
    proxima_cuenta: 3<dominio.CuentaId>,
    proxima_tx:     1<dominio.TransaccionId>,
  }
  let movs = [
    dominio.Debito(1<dominio.CuentaId>, 50.0<dominio.USD>),     # +50 a caja
    dominio.Credito(2<dominio.CuentaId>, 50.0<dominio.USD>),    # -50 a ventas
  ]
  let (r, s2) = almacen.procesar(dominio.Registrar("venta", movs), s)
  let ok = match r {
    dominio.TransaccionRegistrada(_) -> true
    _                                 -> false
  }
  assert ok
  let caja = almacen.buscar_cuenta(s2.cuentas, 1<dominio.CuentaId>)
  let saldo_caja = match caja {
    Some(c) -> c.saldo
    None    -> 0.0<dominio.USD>
  }
  assert saldo_caja == 50.0<dominio.USD>
}
