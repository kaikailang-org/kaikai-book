# Validación de cuadre: la suma de débitos debe igualar la
# suma de créditos en una transacción. Es la invariante
# central de un ledger de doble entrada.
#
# La función `cuadra` es pura. La verificamos con tests y la
# usamos como precondición de `aplicar_si_cuadra`. Como su fila
# de efectos es vacía, los predicados `requires`/`ensures` la
# pueden llamar sin marcadores extra.

import dominio

# El monto de un movimiento, si es del lado que se pide.
fn debito(m: dominio.Movimiento) : [Real<USD>] = match m {
  dominio.Debito(_, monto) -> [monto]
  dominio.Credito(_, _) -> []
}

fn credito(m: dominio.Movimiento) : [Real<USD>] = match m {
  dominio.Credito(_, monto) -> [monto]
  dominio.Debito(_, _) -> []
}

# Suma los débitos de una lista de movimientos.
pub fn total_debitos(ms: [dominio.Movimiento]) : Real<USD> = ms || debito |> list.sum

# Suma los créditos.
pub fn total_creditos(ms: [dominio.Movimiento]) : Real<USD> = ms || credito |> list.sum

# La invariante: ambas sumas son iguales. La pureza se deriva
# de la fila de efectos vacía, así que `requires`/`ensures` la
# pueden invocar directamente desde sus predicados.
pub fn cuadra(ms: [dominio.Movimiento]) : Bool =
  total_debitos(ms) == total_creditos(ms)

# Versión con contrato del cap. 11: si llamas a esta función,
# garantizas que los movimientos cuadran. El compilador
# inserta un assert si no lo puede verificar estáticamente.
pub fn aplicar_si_cuadra(ms: [dominio.Movimiento]) : [dominio.Movimiento]
  requires cuadra(ms)
  ensures cuadra(result)
= ms

test "cuadra con una entrada y una salida" {
  let ms = [
    dominio.Debito(1<CuentaId>, 100.0<USD>),
    dominio.Credito(2<CuentaId>, 100.0<USD>)
  ]
  assert cuadra(ms)
}

test "no cuadra cuando los montos difieren" {
  let ms = [
    dominio.Debito(1<CuentaId>, 100.0<USD>),
    dominio.Credito(2<CuentaId>, 90.0<USD>)
  ]
  assert not cuadra(ms)
}

test "cuadra con múltiples líneas" {
  let ms = [
    dominio.Debito(1<CuentaId>, 60.0<USD>),
    dominio.Debito(2<CuentaId>, 40.0<USD>),
    dominio.Credito(3<CuentaId>, 100.0<USD>)
  ]
  assert cuadra(ms)
}
