# El log de auditoría del ledger. Cada transacción
# registrada se escribe a un archivo append-only. En
# contabilidad real esto no es negociable: las transacciones
# nunca se modifican, solo se agregan correcciones. El
# archivo es evidencia.
#
# Como en el cap. 17, aislar las escrituras en un actor
# permite que el almacén siga respondiendo mientras el disco
# está ocupado.

import actor
import fs.file

pub type Evento = Linea(String)

# Cuerpo del actor. Anexa cada línea y se llama
# recursivamente a la espera del próximo evento.
pub fn persistencia_loop(path: String) : Unit / Actor[Evento] + File = {
  match Actor.receive() {
    Linea(s) -> {
      file.append(path, s ++ "\n")
      persistencia_loop(path)
    }
  }
}

# Trunca el archivo de log antes de arrancar el actor para
# que cada corrida empiece con un log vacío.
pub fn reset_log(path: String) : Unit / File = {
  file.write(path, "")
}
