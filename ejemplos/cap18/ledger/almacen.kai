# El almacén del ledger. Actor que mantiene la lista de
# cuentas y la lista de transacciones registradas.
#
# La lógica de procesamiento es pura (función `procesar`) y se
# testea sin arrancar fibras. El bucle del actor solo la
# conecta a `Actor.receive()`.
#
# El almacén nunca borra ni modifica una transacción
# registrada: las transacciones son inmutables. Solo se
# acumulan. Eso le da al ledger su valor de auditoría: una vez
# escrito un asiento, queda fijo.

import actor
import dominio
import cuadre

pub type AlmacenMsg  = Pregunta(dominio.Comando, Pid[AlmacenResp])
pub type AlmacenResp = Respuesta(dominio.Respuesta)

# El estado del almacén: cuentas conocidas, transacciones
# registradas, contadores de próximos IDs.
type Estado = {
  cuentas:        [dominio.Cuenta],
  transacciones:  [dominio.Transaccion],
  proxima_cuenta: Int<CuentaId>,
  proxima_tx:     Int<TransaccionId>,
}

# La lógica pura. Recibe el comando y el estado actual,
# devuelve la respuesta y el estado nuevo. Sin efectos.
pub fn procesar(c: dominio.Comando, s: Estado) : (dominio.Respuesta, Estado) {
  match c {
    CrearCuenta(nombre) -> {
      let nueva = dominio.Cuenta {
        id:     s.proxima_cuenta,
        nombre: nombre,
        saldo:  0.0<USD>,
      }
      let s2 = Estado {
        ...s,
        cuentas:        [nueva, ...s.cuentas],
        proxima_cuenta: s.proxima_cuenta + 1<CuentaId>,
      }
      (dominio.CuentaCreada(nueva), s2)
    }
    Registrar(desc, movs) ->
      if not cuadre.cuadra(movs) {
        (dominio.ErrorDescuadre(
          "débitos #{cuadre.total_debitos(movs)}, créditos #{cuadre.total_creditos(movs)}"
        ), s)
      } else {
        match verificar_cuentas(movs, s.cuentas) {
          Some(id_faltante) -> (dominio.ErrorCuentaInexistente(id_faltante), s)
          None -> {
            let tx = dominio.Transaccion {
              id:          s.proxima_tx,
              descripcion: desc,
              movimientos: movs,
            }
            let cuentas_actualizadas = aplicar_movs(s.cuentas, movs)
            let s2 = Estado {
              cuentas:        cuentas_actualizadas,
              transacciones:  [tx, ...s.transacciones],
              proxima_cuenta: s.proxima_cuenta,
              proxima_tx:     s.proxima_tx + 1<TransaccionId>,
            }
            (dominio.TransaccionRegistrada(tx), s2)
          }
        }
      }
    ConsultarSaldo(id) ->
      match buscar_cuenta(s.cuentas, id) {
        Some(c) -> (dominio.SaldoActual(c.saldo), s)
        None    -> (dominio.ErrorCuentaInexistente(id), s)
      }
    Listar ->
      (dominio.ListaCuentas(s.cuentas), s)
  }
}

# Verifica que todas las cuentas mencionadas en los
# movimientos existan. Si encuentra una que falta, devuelve su
# id; si todas existen, None.
fn verificar_cuentas(ms: [dominio.Movimiento], cuentas: [dominio.Cuenta])
    : Option[Int<CuentaId>] {
  match ms {
    []           -> None
    [m, ...rest] -> {
      let id = id_de(m)
      match buscar_cuenta(cuentas, id) {
        None    -> Some(id)
        Some(_) -> verificar_cuentas(rest, cuentas)
      }
    }
  }
}

fn id_de(m: dominio.Movimiento) : Int<CuentaId> =
  match m {
    dominio.Debito(id, _)  -> id
    dominio.Credito(id, _) -> id
  }

fn buscar_cuenta(cs: [dominio.Cuenta], id: Int<CuentaId>) : Option[dominio.Cuenta] {
  match cs {
    []           -> None
    [c, ...rest] -> if c.id == id { Some(c) } else { buscar_cuenta(rest, id) }
  }
}

# Aplica los movimientos al saldo de cada cuenta. Los débitos
# suman al saldo, los créditos restan. (Convención del demo;
# en contabilidad real depende del tipo de cuenta — activo
# vs pasivo — pero la idea es la misma.)
fn aplicar_movs(cs: [dominio.Cuenta], ms: [dominio.Movimiento]) : [dominio.Cuenta] {
  match ms {
    []           -> cs
    [m, ...rest] -> aplicar_movs(aplicar_uno(cs, m), rest)
  }
}

fn aplicar_uno(cs: [dominio.Cuenta], m: dominio.Movimiento) : [dominio.Cuenta] {
  let (id, delta) = delta_de(m)
  list.map(cs, (c) => {
    if c.id == id { dominio.Cuenta { ...c, saldo: c.saldo + delta } }
    else          { c }
  })
}

fn delta_de(m: dominio.Movimiento) : (Int<CuentaId>, Real<USD>) =
  match m {
    dominio.Debito(id, n)  -> (id, n)
    dominio.Credito(id, n) -> (id, 0.0<USD> - n)
  }

# Bucle del actor.
fn bucle(s: Estado) : Unit / Actor[AlmacenMsg] + Actor[AlmacenResp] {
  match Actor.receive() {
    Pregunta(c, cliente) -> {
      let (resp, s2) = procesar(c, s)
      Actor.send(cliente, Respuesta(resp))
      bucle(s2)
    }
  }
}

pub fn arrancar() : Pid[AlmacenMsg] / Spawn + Cancel + Actor[AlmacenMsg] + Actor[AlmacenResp] {
  let inicial = Estado {
    cuentas:        [],
    transacciones:  [],
    proxima_cuenta: 1<CuentaId>,
    proxima_tx:     1<TransaccionId>,
  }
  spawn_actor(() => bucle(inicial))
}

pub fn preguntar(almacen: Pid[AlmacenMsg], c: dominio.Comando)
    : dominio.Respuesta / Actor[AlmacenMsg] + Actor[AlmacenResp] + Cancel {
  Actor.send(almacen, Pregunta(c, Actor.self()))
  match Actor.receive() {
    Respuesta(r) -> r
  }
}

# Tests sobre la lógica pura, sin actores.

test "crear una cuenta agrega al estado" {
  let s = Estado { cuentas: [], transacciones: [], proxima_cuenta: 1<CuentaId>, proxima_tx: 1<TransaccionId> }
  let (r, s2) = procesar(dominio.CrearCuenta("caja"), s)
  let ok = match r {
    dominio.CuentaCreada(c) -> c.nombre == "caja"
    _                        -> false
  }
  assert ok
  assert list.length(s2.cuentas) == 1
}

test "registrar transacción rechaza descuadre" {
  let s = Estado {
    cuentas:        [dominio.Cuenta { id: 1<CuentaId>, nombre: "a", saldo: 0.0<USD> }],
    transacciones:  [],
    proxima_cuenta: 2<CuentaId>,
    proxima_tx:     1<TransaccionId>,
  }
  let movs = [dominio.Debito(1<CuentaId>, 100.0<USD>)]   # solo débito, no cuadra
  let (r, _) = procesar(dominio.Registrar("test", movs), s)
  let ok = match r {
    dominio.ErrorDescuadre(_) -> true
    _                          -> false
  }
  assert ok
}

test "registrar transacción que cuadra actualiza saldos" {
  let s = Estado {
    cuentas: [
      dominio.Cuenta { id: 1<CuentaId>, nombre: "caja",   saldo: 0.0<USD> },
      dominio.Cuenta { id: 2<CuentaId>, nombre: "ventas", saldo: 0.0<USD> },
    ],
    transacciones:  [],
    proxima_cuenta: 3<CuentaId>,
    proxima_tx:     1<TransaccionId>,
  }
  let movs = [
    dominio.Debito(1<CuentaId>, 50.0<USD>),     # +50 a caja
    dominio.Credito(2<CuentaId>, 50.0<USD>),    # -50 a ventas
  ]
  let (r, s2) = procesar(dominio.Registrar("venta", movs), s)
  let ok = match r {
    dominio.TransaccionRegistrada(_) -> true
    _                                 -> false
  }
  assert ok
  # caja sube a 50, ventas baja a -50.
  let saldo_caja = match list.head(s2.cuentas |? (c) => c.id == 1<CuentaId>) {
    Some(c) -> c.saldo
    None    -> 0.0<USD>
  }
  assert saldo_caja == 50.0<USD>
}
