# El almacén del ledger. Actor que mantiene la lista de
# cuentas y la lista de transacciones registradas.
#
# Tres piezas:
#   - `procesar` es la lógica pura (sin efectos), testeable
#     aisladamente.
#   - `almacen_loop` es el cuerpo del actor: envuelve a
#     `procesar` en un loop sobre `Actor.receive()`.
#   - `preguntar` es el wrapper sincrónico para el cliente.
#
# El almacén nunca borra ni modifica una transacción
# registrada: las transacciones son inmutables. Solo se
# acumulan. Eso le da al ledger su valor de auditoría: una
# vez escrito un asiento, queda fijo.

import actor
import dominio
import cuadre

# Protocolo del almacén: el comando más el Pid del que pide
# la respuesta. El almacén lee `Pregunta`, calcula, manda de
# vuelta `Respondido`.
pub type AlmacenMsg  = Pregunta(dominio.Comando, Pid[AlmacenResp])
pub type AlmacenResp = Respondido(dominio.Respuesta)

# Estado del almacén: cuentas conocidas, transacciones
# registradas, contadores de próximos IDs.
pub type Estado = {
  cuentas:        [dominio.Cuenta],
  transacciones:  [dominio.Transaccion],
  proxima_cuenta: Int<CuentaId>,
  proxima_tx:     Int<TransaccionId>,
}

pub fn estado_inicial() : Estado = Estado {
  cuentas:        [],
  transacciones:  [],
  proxima_cuenta: 1<CuentaId>,
  proxima_tx:     1<TransaccionId>,
}

# Lógica pura. Recibe el comando y el estado actual, devuelve
# la respuesta y el estado nuevo. Sin efectos.
pub fn procesar(c: dominio.Comando, s: Estado) : (dominio.Respuesta, Estado) = match c {
  CrearCuenta(nombre) -> {
    let nueva = dominio.Cuenta {
      id:     s.proxima_cuenta,
      nombre: nombre,
      saldo:  0.0<USD>,
    }
    let s2 = Estado {
      cuentas:        [nueva, ...s.cuentas],
      transacciones:  s.transacciones,
      proxima_cuenta: s.proxima_cuenta + 1<CuentaId>,
      proxima_tx:     s.proxima_tx,
    }
    (dominio.CuentaCreada(nueva), s2)
  }
  Registrar(desc, movs) ->
    if not cuadre.esta_cuadrada(movs) {
      (dominio.ErrorDescuadre(
        "débitos #{cuadre.total_debitos(movs)}, créditos #{cuadre.total_creditos(movs)}"
      ), s)
    } else {
      match verificar_cuentas(movs, s.cuentas) {
        Some(id_faltante) -> (dominio.ErrorCuentaInexistente(id_faltante), s)
        None -> {
          let tx = dominio.Transaccion {
            id:          s.proxima_tx,
            descripcion: desc,
            movimientos: movs,
          }
          let cuentas_nuevas = aplicar_movs(s.cuentas, movs)
          let s2 = Estado {
            cuentas:        cuentas_nuevas,
            transacciones:  [tx, ...s.transacciones],
            proxima_cuenta: s.proxima_cuenta,
            proxima_tx:     s.proxima_tx + 1<TransaccionId>,
          }
          (dominio.TransaccionRegistrada(tx), s2)
        }
      }
    }
  ConsultarSaldo(id_buscado) ->
    match buscar_cuenta(s.cuentas, id_buscado) {
      Some(c) -> (dominio.SaldoActual(c.saldo), s)
      None    -> (dominio.ErrorCuentaInexistente(id_buscado), s)
    }
  Listar ->
    (dominio.ListaCuentas(s.cuentas), s)
}

# Verifica que cada cuenta mencionada en los movimientos
# exista. Si falta una, devuelve su id; si todas existen, None.
fn verificar_cuentas(ms: [dominio.Movimiento], cuentas: [dominio.Cuenta]) : Option[Int<CuentaId>] = match ms {
  []           -> None
  [m, ...rest] -> {
    let id_buscado = id_de(m)
    match buscar_cuenta(cuentas, id_buscado) {
      None    -> Some(id_buscado)
      Some(_) -> verificar_cuentas(rest, cuentas)
    }
  }
}

fn id_de(m: dominio.Movimiento) : Int<CuentaId> = match m {
  dominio.Debito(id_buscado, _)  -> id_buscado
  dominio.Credito(id_buscado, _) -> id_buscado
}

pub fn buscar_cuenta(cs: [dominio.Cuenta], id_buscado: Int<CuentaId>) : Option[dominio.Cuenta] = match cs {
  []           -> None
  [c, ...rest] -> if c.id == id_buscado { Some(c) } else { buscar_cuenta(rest, id_buscado) }
}

# Aplica los movimientos al saldo de cada cuenta. Los débitos
# suman al saldo, los créditos restan. (Convención del demo;
# en contabilidad real depende del tipo de cuenta — activo
# vs pasivo — pero la idea es la misma.)
fn aplicar_movs(cs: [dominio.Cuenta], ms: [dominio.Movimiento]) : [dominio.Cuenta] = match ms {
  []           -> cs
  [m, ...rest] -> aplicar_movs(aplicar_uno(cs, m), rest)
}

# Recursión manual (en vez de `list.map` + lambda) porque
# kaikai 0.70 todavía tropieza al resolver tipos cualificados
# de records dentro del spread sugar (`mod.Tipo { ...x, campo: ... }`).
# Por lo mismo construimos el record actualizado campo por
# campo, sin spread.
fn aplicar_uno(cs: [dominio.Cuenta], m: dominio.Movimiento) : [dominio.Cuenta] = {
  let (id_buscado, delta) = delta_de(m)
  recorrer_cuentas(cs, id_buscado, delta)
}

fn recorrer_cuentas(cs: [dominio.Cuenta], id_buscado: Int<CuentaId>, delta: Real<USD>) : [dominio.Cuenta] = match cs {
  []           -> []
  [c, ...rest] -> {
    let actualizada = if c.id == id_buscado {
      dominio.Cuenta { id: c.id, nombre: c.nombre, saldo: c.saldo + delta }
    } else {
      c
    }
    [actualizada, ...recorrer_cuentas(rest, id_buscado, delta)]
  }
}

fn delta_de(m: dominio.Movimiento) : (Int<CuentaId>, Real<USD>) = match m {
  dominio.Debito(id_buscado, n)  -> (id_buscado, n)
  dominio.Credito(id_buscado, n) -> (id_buscado, 0.0<USD> - n)
}

# Cuerpo del actor. Recibe una `Pregunta`, llama a `procesar`,
# manda la respuesta de vuelta, recursa con el nuevo estado.
# Lleva tanto Actor[AlmacenMsg] (el mailbox propio del actor,
# instalado por spawn_actor) como Actor[AlmacenResp] (usado
# solo por `Actor.send` — el mailbox es propiedad de la fibra
# que llama).
pub fn almacen_loop(s: Estado) : Unit / Actor[AlmacenMsg] + Actor[AlmacenResp] = {
  match Actor.receive() {
    Pregunta(c, cliente) -> {
      let (resp, s2) = procesar(c, s)
      Actor.send(cliente, Respondido(resp))
      almacen_loop(s2)
    }
  }
}

# Helper del lado del cliente. El que llama debe tener un
# mailbox Actor[AlmacenResp] (la respuesta cae ahí).
pub fn preguntar(almacen: Pid[AlmacenMsg], c: dominio.Comando) : dominio.Respuesta / Actor[AlmacenMsg] + Actor[AlmacenResp] = {
  Actor.send(almacen, Pregunta(c, Actor.self()))
  match Actor.receive() {
    Respondido(r) -> r
  }
}

# Los tests viven en `almacen_tests.kai` — kaikai 0.74.0 tiene un
# bug que rompe la resolución de exports cuando bloques `test "..."`
# y otro módulo local (`cuadre`) se cargan juntos.
