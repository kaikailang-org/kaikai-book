# Alias de unidades: dar nombre a una composición.
#
# `unit Newton = kg * m / sec^2` declara `Newton` como sinónimo
# de la unidad de fuerza. Lo usas como cualquier unidad básica.

unit m
unit sec
unit kg
unit Newton = kg * m / sec^2

fn main() {
  let g : Real<m / sec^2> = 9.81<m / sec^2>
  let masa : Real<kg> = 70.0<kg>
  let fuerza : Real<Newton> = masa * g
  println("F = #{fuerza}")

  # Newton y kg*m/sec^2 son la misma unidad — el compilador los
  # acepta intercambiables.
  let fuerza_explicita : Real<kg * m / sec^2> = fuerza
  println("misma unidad: #{fuerza_explicita}")
}
