# Una constante en posición de patrón no liga: compara. El brazo
# calza cuando el valor es igual al de la constante.
#
# La regla completa: un identificador en un patrón liga, salvo que
# nombre una constante en scope, y ahí es una prueba de igualdad.

const PUERTO_HTTP: Int = 80
const PUERTO_HTTPS: Int = 443

fn esquema(p: Int) : String =
  match p {
    PUERTO_HTTP  -> "http"
    PUERTO_HTTPS -> "https"
    _            -> "desconocido"
  }

fn main() : Unit / Stdout {
  Stdout.print(esquema(80))
  Stdout.print(esquema(443))
  Stdout.print(esquema(9000))
}
