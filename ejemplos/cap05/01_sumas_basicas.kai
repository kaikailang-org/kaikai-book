# Tipos suma con `|`. Sin payload (constructores "vacíos") y
# con payload posicional.

type Color = Rojo | Verde | Azul

type Forma
  = Circulo(Real)
  | Rectangulo(Real, Real)
  | Triangulo(Real, Real, Real)

fn area(f: Forma) : Real =
  match f {
    Circulo(r) -> 3.14159 * r * r
    Rectangulo(w, h) -> w * h
    Triangulo(a, b, c) -> {
      # Fórmula de Herón, con s como semiperímetro.
      let s = (a + b + c) / 2.0
      real_sqrt(s * (s - a) * (s - b) * (s - c))
    }
  }

fn nombre(c: Color) : String =
  match c {
    Rojo -> "rojo"
    Verde -> "verde"
    Azul -> "azul"
  }

fn main() {
  println("color: #{nombre(Rojo)}, #{nombre(Verde)}, #{nombre(Azul)}")
  let c = Circulo(2.0)
  let r = Rectangulo(3.0, 4.0)
  let t = Triangulo(3.0, 4.0, 5.0)
  println("círculo: área = #{area(c)}")
  println("rectángulo: área = #{area(r)}")
  println("triángulo: área = #{area(t)}")
}
