import core.string
import core.list

# Un String no es una lista de Char, y "largo" significa dos cosas
# distintas: bytes contra codepoints Unicode.

fn main() {
  let s = "café"

  # length / byte_length cuentan bytes (O(1)).
  # char_count cuenta codepoints Unicode.
  println("bytes:      #{string.length(s)}")       # 5
  println("codepoints: #{string.char_count(s)}")   # 4

  # chars decodifica la vista UTF-8 a codepoints ([Char]);
  # bytes entrega los octetos crudos, uno por byte ([Byte]).
  println("chars:      #{list.length(string.chars(s))}")  # 4
  println("bytes list: #{list.length(string.bytes(s))}")  # 5

  # from_bytes es el inverso de bytes. Los tipos no se cruzan:
  # pasarle estos octetos a from_chars no compilaría.
  println("de vuelta:  #{string.from_bytes(string.bytes(s))}")
}
