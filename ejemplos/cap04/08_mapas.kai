# HashMap y HashSet: las dos estructuras asociativas del
# stdlib. El HashMap asocia claves a valores; el HashSet
# guarda un conjunto sin duplicados. A diferencia de records
# y listas, son mutables: sus escrituras rinden el efecto
# `Mutable`, que queda enmascarado cuando la estructura nace y
# se llena dentro de la misma función.

import collections.hashmap as hashmap
import collections.hashset as hashset

# Cuenta cuántas veces aparece cada palabra de una lista.
fn frecuencias(palabras: [String]) : hashmap.HashMap[String, Int] {
  let m = hashmap.empty()
  palabras |! hashmap.put(m, ., m[.].unwrap_or(0) + 1)
  m
}

fn main() : Unit / Stdout {
  let texto = ["sol", "mar", "sol", "viento", "mar", "sol"]
  let m = frecuencias(texto)

  # Indexación m[clave]: devuelve Option, None si la clave falta.
  match m["sol"] {
    Some(n) -> Stdout.print("sol aparece #{n} veces")
    None -> Stdout.print("sol no aparece")
  }
  Stdout.print("palabras distintas: #{hashmap.size(m)}")

  # Un HashSet descarta duplicados al insertar.
  let vistas = hashset.empty()
  texto |! hashset.add(vistas, .)
  Stdout.print("únicas vía set: #{hashset.size(vistas)}")
}
