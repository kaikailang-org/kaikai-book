# Módulo `geometria`. Cualquier archivo que lo importe ve sólo
# las declaraciones marcadas con `pub`.

pub type Punto = { x: Real, y: Real }

pub fn distancia(a: Punto, b: Punto) : Real {
  let dx = a.x - b.x
  let dy = a.y - b.y
  real_sqrt(dx * dx + dy * dy)
}

fn cuadrado(x: Real) : Real = x * x
