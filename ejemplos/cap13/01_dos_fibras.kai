# Dos fibras cooperativas en su forma más simple.
#
# `spawn.spawn` agenda una fibra pero no la corre todavía.
# `spawn.yield` es el punto de cooperación explícito: la fibra
# actual se suspende y el scheduler pasa a otra que esté lista.
#
# Sin los yields, una fibra correría sus tres iteraciones de
# corrido antes de soltarle el turno a la otra. Con yields, las
# dos se intercalan.

import spawn

fn worker(tag: String, n: Int) : Unit / Stdout + Spawn {
  if n > 0 {
    println(tag)
    spawn.yield()
    worker(tag, n - 1)
  }
}

fn main() {
  let f = spawn.spawn(() => worker("B", 3))
  worker("A", 3)
  spawn.await(f)
}
