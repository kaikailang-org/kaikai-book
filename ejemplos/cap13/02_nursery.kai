# La misma idea con un `nursery`: una sintaxis estructurada para
# decir "estas fibras viven dentro de este bloque, y el bloque
# espera a que terminen antes de salir".
#
# `nursery { n -> ... }` abre el scope. `n` es la capacidad para
# crear fibras. Cualquier fibra creada con `n.spawn` es hija del
# nursery; al salir del bloque, el nursery espera a todas sin que
# tengas que pedirlo. Si una falla, las demás se cancelan.

import spawn

fn worker(tag: String, n: Int) : Unit / Stdout + Spawn {
  if n > 0 {
    println(tag)
    spawn.yield()
    worker(tag, n - 1)
  }
}

fn main() : Unit / Stdout + Spawn + Cancel {
  let _ = nursery { n ->
    n.spawn(() => worker("A", 3))
    n.spawn(() => worker("B", 3))
  }
}
