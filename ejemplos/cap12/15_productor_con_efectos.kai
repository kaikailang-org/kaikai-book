# Un productor puede hacer más que `Yield`. Los efectos que realiza
# son el `e` de `Gen[t, e]` y se sirven donde alguien avanza el
# generador, no donde se creó: aquí el `println` del productor lo
# atiende el handler de `main`.
#
# Y se ven las tres que el consumidor pidió, no una cuarta.

import gen.{Yield, generate, take_until, reduce}

fn ruidoso(n: Int) : Unit / Yield[Int] + Stdout = {
  println("  produzco #{n}")
  Yield.yield(n)
  ruidoso(n + 1)
}

fn main() : Unit / Stdout = {
  println("los efectos del productor corren al avanzarlo")
  let suma = generate { ruidoso(1) }
    |> take_until(n => n >= 3)
    |> reduce((a, b) => a + b)
  println("suma = #{suma}")
}
