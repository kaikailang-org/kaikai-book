# Dos fibras cooperativas.
#
# `spawn.spawn` agenda una fibra pero no la ejecuta todavía — el
# scheduler la levanta en el próximo punto de yield. `spawn.yield`
# es un punto explícito de cooperación: la fibra actual se suspende
# y el scheduler toma la siguiente que esté lista.
#
# Sin los yields, ambos workers correrían en bloques arbitrarios.
# Con yields, el scheduler los intercala y el output queda alternado.
#
#   $ kai run ejemplos/cap01/05_concurrente.kai
#   A
#   B
#   A
#   B
#   A
#   B

import spawn

fn worker(tag: String, n: Int) : Unit / Stdout + Spawn {
  if n > 0 {
    println(tag)
    spawn.yield()
    worker(tag, n - 1)
  }
}

fn main() {
  let f = spawn.spawn(() => worker("B", 3))
  worker("A", 3)
  spawn.await(f)
}
