# Precisión arbitraria en el stdlib: BigInt, DecimalBig, Rational.
#
# BigInt nunca desborda; el sufijo `n` construye uno desde un
# literal. DecimalBig es punto fijo sobre BigInt. Rational es una
# fracción exacta, siempre reducida — y `Rational(a, b)` la
# construye directo gracias al atributo `#[constructor]`.

import math.bigint
import math.bigint_proto
import decimal_big as db
import decimal_big_proto
import rational as rat
import rational_proto

fn main() {
  # BigInt: exacto incluso pasado 2^64.
  let a = 1000000007n
  println("a² = #{show(bigint.mul(a, a))}")

  # DecimalBig: sin techo de ancho ni de escala.
  match db.parse("123456789012345678901234567890.123456789") {
    Some(d) -> println("d × 2 = #{show(db.mul(d, db.from_int(2)))}")
    None    -> println("error de parseo")
  }

  # Rational: 1/2 + 1/3 = 5/6, sin redondeo. `Rational(a, b)`
  # pasa por `make`, que reduce a términos mínimos.
  let mitad  = Rational(1, 2)
  let tercio = Rational(1, 3)
  println("1/2 + 1/3 = #{show(rat.add(mitad, tercio))}")
}
