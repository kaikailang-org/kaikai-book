# Un bloque `{ ... }` es una expresión.
# Su valor es el de la última expresión adentro.

fn cuadrado_mas_uno(x: Int) : Int = {
  let cuadrado = x * x
  cuadrado + 1                # valor del bloque
}

fn main() {
  println("f(3) = #{cuadrado_mas_uno(3)}")     # 10
  println("f(5) = #{cuadrado_mas_uno(5)}")     # 26
}
