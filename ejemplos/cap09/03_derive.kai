# `#[derive(...)]` deriva la implementación estructuralmente:
# para cada campo del record, delega en el `impl` del campo.
#
# Para `Show`, esto produce el formato canónico
# `TipoNombre { campo1: ..., campo2: ... }` reutilizando el
# `Show` de cada tipo de campo. Para `Ord`, compara campo a
# campo en el orden en que están declarados.

#[derive(Show)]
type Persona = {
  nombre: String,
  edad: Int
}

#[derive(Show, Ord)]
type Punto = {
  x: Int,
  y: Int
}

fn main() {
  let ada = Persona { nombre: "Ada", edad: 30 }
  println(show(ada))

  # Show automático en interpolación.
  println("registro: #{ada}")

  let p = Punto { x: 3, y: 4 }
  let q = Punto { x: 3, y: 4 }
  let r = Punto { x: 5, y: 5 }

  # La igualdad no se deriva: `==` compara campo a campo.
  println("p == q: #{p == q}")
  println("p == r: #{p == r}")

  # El orden sí, y queda lexicográfico por campos.
  println("p < r: #{p < r}")
  println("mayor: #{max(p, r)}")
}
