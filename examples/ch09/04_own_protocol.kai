# Declaring your own protocol.
#
# `Drawable` declares a contract: any type that implements
# `draw` can be passed to functions that expect `Drawable`.

protocol Drawable {
  draw(x: Self) : String
}

# Three different types, three implementations.

type Circle = { radius: Int }
type Square = { side: Int }
type Triangle = { base: Int, height: Int }

impl Drawable for Circle {
  fn draw(c: Circle) : String =
    "Circle of radius " ++ int_to_string(c.radius)
}

impl Drawable for Square {
  fn draw(s: Square) : String =
    "Square of side " ++ int_to_string(s.side)
}

impl Drawable for Triangle {
  fn draw(t: Triangle) : String =
    "Triangle " ++ int_to_string(t.base) ++ "x" ++ int_to_string(t.height)
}

fn main() {
  let c = Circle { radius: 5 }
  let s = Square { side: 3 }
  let t = Triangle { base: 4, height: 6 }

  println(draw(c))
  println(draw(s))
  println(draw(t))
}
