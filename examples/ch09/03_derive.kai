# `#[derive(...)]` derives the implementation structurally:
# for each field of the record, delegates to its impl.
#
# For `Show`, this produces the canonical format
# `TypeName { field1: ..., field2: ... }` reusing the `Show`
# of each field type. For `Ord`, it compares field by field in
# declaration order.

#[derive(Show)]
type Person = {
  name: String,
  age: Int
}

#[derive(Show, Ord)]
type Point = {
  x: Int,
  y: Int
}

fn main() {
  let ada = Person { name: "Ada", age: 30 }
  println(show(ada))

  # Automatic Show in interpolation.
  println("record: #{ada}")

  let p = Point { x: 3, y: 4 }
  let q = Point { x: 3, y: 4 }
  let r = Point { x: 5, y: 5 }

  # Equality is not derived: `==` compares field by field.
  println("p == q: #{p == q}")
  println("p == r: #{p == r}")

  # Ordering is, and it comes out lexicographic by field.
  println("p < r: #{p < r}")
  println("greater: #{max(p, r)}")
}
