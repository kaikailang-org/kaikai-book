# Cancellation with cleanup. When a sibling fiber goes down, the
# nursery cancels the others. A fiber that has things to clean
# up (close files, release connections, write a log) installs
# a handler for `Cancel`. The handler runs the cleanup and
# does NOT call `resume`: the fiber unwinds.
#
# A fiber doesn't inherit the handlers of whoever spawns it, so
# the one that gives up handles its own `Fail` inside the spawned
# body and turns it into `Cancel.raise()`: that's what the nursery
# reads as a child going down.

import spawn

# A fiber that counts as long as nobody cancels it.
fn long_worker(tag: String) : Unit / Stdout + Spawn + Cancel {
  handle {
    count(tag, 0)
  } with Cancel {
    raise(resume) -> {
      println("#{tag}: canceled, doing cleanup")
      # not calling resume: the fiber unwinds
    }
  }
}

fn count(tag: String, n: Int) : Unit / Stdout + Spawn + Cancel {
  println("#{tag}: #{n}")
  spawn.yield()
  count(tag, n + 1)
}

# A fiber that gives up after a few steps.
fn quit(n: Int) : Unit / Stdout + Spawn + Fail {
  if n > 2 {
    Fail.fail("quitting after 3 steps")
  } else {
    println("step #{n}")
    spawn.yield()
    quit(n + 1)
  }
}

effect Fail {
  fail(reason: String) : Nothing
}

fn main() : Unit / Stdout + Spawn + Cancel {
  nursery { n ->
    n.spawn(() => long_worker("A"))
    n.spawn(() => long_worker("B"))
    let r = n.spawn(() => handle {
      quit(0)
    } with Fail {
      fail(reason, resume) -> {
        println("the fiber gives up: #{reason}")
        Cancel.raise()
      }
    })
    n.await(r)
  }
}
