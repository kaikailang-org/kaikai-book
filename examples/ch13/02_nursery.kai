# Same idea with a `nursery`: a structured syntax saying
# "these fibers live inside this block, and the block waits
# for them to finish before exiting".
#
# `nursery { n -> ... }` opens the scope. `n` is the capacity
# for creating fibers. Any fiber created with `n.spawn` is a
# child of the nursery; on block exit, the nursery waits for
# them all without being asked. If one fails, the others are
# canceled.

import spawn

fn worker(tag: String, n: Int) : Unit / Stdout + Spawn {
  if n > 0 {
    println(tag)
    spawn.yield()
    worker(tag, n - 1)
  }
}

fn main() : Unit / Stdout + Spawn + Cancel {
  let _ = nursery { n ->
    n.spawn(() => worker("A", 3))
    n.spawn(() => worker("B", 3))
  }
}
