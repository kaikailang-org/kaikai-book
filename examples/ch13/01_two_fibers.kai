# Two cooperative fibers in the simplest form.
#
# `spawn.spawn` schedules a fiber but doesn't run it yet.
# `spawn.yield` is the explicit cooperation point: the
# current fiber suspends and the scheduler picks another
# ready one.
#
# Without yields, one fiber would run its three iterations
# back-to-back before handing control to the other. With
# yields, the two interleave.

import spawn

fn worker(tag: String, n: Int) : Unit / Stdout + Spawn {
  if n > 0 {
    println(tag)
    spawn.yield()
    worker(tag, n - 1)
  }
}

fn main() {
  let f = spawn.spawn(() => worker("B", 3))
  worker("A", 3)
  spawn.await(f)
}
