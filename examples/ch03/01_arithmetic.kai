# Basic arithmetic.
#
# `+`, `-`, `*`, `/`, `%` are overloaded: they accept Int or Real.
# No implicit coercion between Int and Real.
# On Int, `/` truncates. For a fractional result, use Real.

fn main() {
  let a : Int = 7
  let b : Int = 2

  println("a + b = #{a + b}")
  println("a * b = #{a * b}")
  println("a / b = #{a / b}")     # 3 (on Int, / truncates)
  println("a % b = #{a % b}")     # 1

  println("7.0 / 2.0 = #{7.0 / 2.0}")    # 3.5
  println("9.0 / 2.0 = #{9.0 / 2.0}")    # 4.5
}
