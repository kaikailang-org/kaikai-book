# Arbitrary precision in the stdlib: BigInt, DecimalBig, Rational.
#
# BigInt never overflows; the `n` suffix builds one from a
# literal. DecimalBig is fixed-point over BigInt. Rational is an
# exact fraction, always in lowest terms — and `Rational(a, b)`
# builds one directly thanks to the `#[constructor]` attribute.

import math.bigint
import decimal_big as db
import rational as rat

fn main() {
  # BigInt: exact even past 2^64.
  let a = 1000000007n
  println("a² = #{show(bigint.mul(a, a))}")

  # DecimalBig: no width or scale ceiling.
  match db.parse("123456789012345678901234567890.123456789") {
    Some(d) -> println("d × 2 = #{show(db.mul(d, db.from_int(2)))}")
    None -> println("parse error")
  }

  # Rational: 1/2 + 1/3 = 5/6, no rounding. `Rational(a, b)`
  # routes through `make`, which reduces to lowest terms.
  let half = Rational(1, 2)
  let third = Rational(1, 3)
  println("1/2 + 1/3 = #{show(rat.add(half, third))}")
}
