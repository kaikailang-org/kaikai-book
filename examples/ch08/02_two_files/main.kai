# `import geometry` makes the module's `pub` items accessible
# under the prefix `geometry.`. The same prefix works for
# functions (geometry.distance) and for type constructors
# (geometry.Point { ... }).

import geometry

fn main() {
  let a : geometry.Point = geometry.Point { x: 0.0, y: 0.0 }
  let b : geometry.Point = geometry.Point { x: 3.0, y: 4.0 }
  println("distance = #{geometry.distance(a, b)}")
}
