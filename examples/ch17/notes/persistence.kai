# The persistence actor: receives log lines and appends them
# to a file.  Isolating the file write in its own actor lets
# the store keep responding without waiting on disk.

import fs.file

pub type Event = Line(String)

# Actor body.  Appends each line and recurses to await the
# next event.
pub fn persistence_loop(path: String) : Unit / Actor[Event] + File {
  match Actor.receive() {
    Line(s) -> match file.append(path, s ++ "\n") {
      Ok(_) -> persistence_loop(path)
      Err(e) -> panic("could not write the log: " ++ e)
    }
  }
}

# Truncate the log file before the actor starts so each run
# begins with an empty log.
pub fn reset_log(path: String) : Unit / File {
  match file.write(path, "") {
    Ok(_) -> ()
    Err(e) -> panic("could not truncate the log: " ++ e)
  }
}
