# The persistence actor receives each note created or
# deleted and writes it to a log file. In a real system, its
# mailbox would be `Bounded(N, DropOldest)` to protect
# against flooding. Here we use `spawn_actor` (Unbounded
# default) because for the demo it's enough.

import actor
import fs.file

pub type Event = Line(String)

fn loop(path: String) : Unit / Actor[Event] + File {
  match Actor.receive() {
    Line(s) -> {
      file.file_append(path, s ++ "\n")
      loop(path)
    }
  }
}

pub fn start(path: String)
    : Pid[Event] / Spawn + Cancel + Actor[Event] + File {
  # Truncate the file on start so we begin clean.
  file.file_write_file(path, "")
  spawn_actor(() => loop(path))
}
