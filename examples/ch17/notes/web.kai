# Minimal HTTP parser and serializer for the notes server.
# Pure string manipulation — no effects.  In production you'd
# use `stdlib/net/http.kai`; here we write it by hand so the
# whole chain fits in the reader's head.

import domain

#[derive(Show)]
pub type HttpReq = { method: String, path: String, body: String }

# bytes ⇄ String conversions for the buffers `NetTcp` returns and
# accepts. Inlined so the whole chain fits in the reader's head,
# without pulling in `net.http`.
fn string_to_bytes_loop(s: String, i: Int, n: Int, acc: [Int]) : [Int] =
  if i >= n { list_reverse(acc) }
  else { match char_at(s, i) {
    Some(c) -> string_to_bytes_loop(s, i + 1, n, [char_to_int(c), ...acc])
    None    -> list_reverse(acc)
  } }

pub fn string_to_bytes(s: String) : [Int] =
  string_to_bytes_loop(s, 0, string_length(s), [])

fn byte_to_str(b: Int) : String = "#{int_to_char(b)}"

pub fn bytes_to_string(bs: [Int]) : String =
  string_concat_all(list.map(bs, byte_to_str))

pub fn parse_request(raw: String) : Result[HttpReq, String] = {
  match string.split(raw, "\r\n\r\n") {
    [head, ...body_parts] -> {
      let body = string.join(body_parts, "\r\n\r\n")
      match string.split(head, "\r\n") {
        [first, ..._] -> parse_first_line(first, body)
        []            -> Err("empty request")
      }
    }
    _ -> Err("request missing header separator")
  }
}

fn parse_first_line(line: String, body: String) : Result[HttpReq, String] = {
  match string.split(line, " ") {
    [method, path, ..._] -> Ok(HttpReq { method: method, path: path, body: body })
    _                     -> Err("malformed first line: '#{line}'")
  }
}

# Translate an HttpReq into a domain Command.  If the URL
# doesn't match any route, return an immediate Reply.
pub fn route(req: HttpReq) : Result[domain.Command, domain.Reply] = {
  if req.method == "GET" {
    if req.path == "/notes" {
      Ok(domain.List)
    } else {
      route_id(req.path, (id) => domain.Get(id))
    }
  } else if req.method == "POST" {
    if req.path == "/notes" {
      Ok(domain.Create(req.body))
    } else {
      Err(domain.NotFound)
    }
  } else if req.method == "DELETE" {
    route_id(req.path, (id) => domain.Delete(id))
  } else {
    Err(domain.NotFound)
  }
}

fn drop_prefix(s: String, prefix: String) : String = {
  let n = string.length(prefix)
  string.slice(s, n, string.length(s) - n)
}

fn route_id(path: String, f: (Int) -> domain.Command) : Result[domain.Command, domain.Reply] = {
  if string.starts_with(path, "/notes/") {
    let suffix = drop_prefix(path, "/notes/")
    match string.to_int(suffix) {
      Some(n) -> Ok(f(n))
      None    -> Err(domain.ClientError("invalid id in path: '#{path}'"))
    }
  } else {
    Err(domain.NotFound)
  }
}

# Serialise a domain Reply into HTTP bytes.
pub fn serialize_reply(r: domain.Reply) : String = match r {
  domain.Stored(body)     -> response(200, "OK", body)
  domain.Created(note)    -> response(201, "Created", "#{note}")
  domain.NotFound         -> response(404, "Not Found", "")
  domain.ClientError(msg) -> response(400, "Bad Request", msg)
  domain.ServerError(msg) -> response(500, "Internal Error", msg)
}

fn response(status: Int, reason: String, body: String) : String = {
  let len = string.length(body)
  "HTTP/1.1 #{status} #{reason}\r\nContent-Length: #{len}\r\nContent-Type: text/plain\r\n\r\n#{body}"
}

test "parse GET /notes" {
  let raw = "GET /notes HTTP/1.1\r\nHost: x\r\n\r\n"
  let ok = match parse_request(raw) {
    Ok(r)  -> r.method == "GET" and r.path == "/notes"
    Err(_) -> false
  }
  assert ok
}

test "route POST /notes" {
  let req = HttpReq { method: "POST", path: "/notes", body: "hi" }
  let ok = match route(req) {
    Ok(domain.Create(c)) -> c == "hi"
    _                     -> false
  }
  assert ok
}
