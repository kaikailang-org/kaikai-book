# The notes store is an actor. It lives as a fiber with a
# mailbox, keeps the list of notes as internal state, and
# answers commands sent by the HTTP handlers.
#
# Since it lives in a single actor, there's no concurrency
# between writes: each command is processed in order. That
# avoids races without locks.

import actor
import domain

# The store's protocol: the domain command plus the Pid of
# whoever is asking, so the store can reply.
pub type StoreMsg = Ask(domain.Command, Pid[StoreResp])
pub type StoreResp = Reply(domain.Response)

# The actor's loop. Receives an ask, decides what to do
# based on state, replies, and recurses with the updated
# state.
fn loop(notes: [domain.Note], next_id: Int)
    : Unit / Actor[StoreMsg] + Actor[StoreResp] {
  match Actor.receive() {
    Ask(command, client) -> {
      let (resp, new_notes, new_id) =
        process(command, notes, next_id)
      Actor.send(client, Reply(resp))
      loop(new_notes, new_id)
    }
  }
}

# The pure logic: given a command and the state, return the
# response, the new notes and the new next id. No effects.
# Testable without starting fibers.
pub fn process(c: domain.Command, notes: [domain.Note], next_id: Int)
    : (domain.Response, [domain.Note], Int) {
  match c {
    List -> {
      let bodies = list.map(notes, (n) => n.body)
      (domain.Ok(serialise_list(bodies)), notes, next_id)
    }
    Get(id) ->
      match find(notes, id) {
        Some(n) -> (domain.Ok(n.body), notes, next_id)
        None    -> (domain.NotFound, notes, next_id)
      }
    Create(body) -> {
      let n = domain.Note { id: next_id, body: body }
      (domain.Created(n), [n, ...notes], next_id + 1)
    }
    Delete(id) ->
      match find(notes, id) {
        Some(_) -> {
          let remaining = list.filter(notes, (n) => n.id != id)
          (domain.Ok("deleted"), remaining, next_id)
        }
        None -> (domain.NotFound, notes, next_id)
      }
  }
}

fn find(notes: [domain.Note], id: Int) : Option[domain.Note] {
  match notes {
    []           -> None
    [h, ...rest] -> if h.id == id { Some(h) } else { find(rest, id) }
  }
}

fn serialise_list(bodies: [String]) : String {
  match bodies {
    []           -> "[]"
    [h, ...rest] -> "[" ++ h ++ join(rest) ++ "]"
  }
}

fn join(xs: [String]) : String {
  match xs {
    []           -> ""
    [h, ...rest] -> ", " ++ h ++ join(rest)
  }
}

# Start the store as an actor. Returns the Pid so the server
# can send it asks.
pub fn start() : Pid[StoreMsg] / Spawn + Cancel + Actor[StoreMsg] + Actor[StoreResp] {
  spawn_actor(() => loop([], 1))
}

# Helper for a client of the store to make a synchronous ask:
# send, wait for the reply, return it.
pub fn ask(store: Pid[StoreMsg], c: domain.Command)
    : domain.Response / Actor[StoreMsg] + Actor[StoreResp] + Cancel {
  Actor.send(store, Ask(c, Actor.self()))
  match Actor.receive() {
    Reply(r) -> r
  }
}

test "create and get" {
  let (r1, n1, id1) = process(domain.Create("first"), [], 1)
  let created_ok = match r1 {
    domain.Created(_) -> true
    _                  -> false
  }
  assert created_ok
  assert id1 == 2

  let (r2, _, _) = process(domain.Get(1), n1, id1)
  let get_ok = match r2 {
    domain.Ok(c) -> c == "first"
    _             -> false
  }
  assert get_ok
}

test "get missing note" {
  let (r, _, _) = process(domain.Get(99), [], 1)
  let ok = match r {
    domain.NotFound -> true
    _                -> false
  }
  assert ok
}

test "delete shrinks the list" {
  let (_, n1, id1) = process(domain.Create("a"), [], 1)
  let (_, n2, id2) = process(domain.Create("b"), n1, id1)
  let (r, n3, _)   = process(domain.Delete(1), n2, id2)
  let ok = match r {
    domain.Ok(_) -> true
    _             -> false
  }
  assert ok
  assert list.length(n3) == 1
}
