# Tests for the store. Lives in a separate file because of a
# kaikai 0.74.0 typer bug: combining `import store` + `import web`
# in `main.kai` breaks export resolution whenever `store.kai`
# contains direct `test "..."` blocks. `main.kai` does not import
# this file; `kai test` still picks it up over the whole project.

import store
import domain

test "create and get" {
  let (r1, n1, id1) = store.process(domain.Create("first"), [], 1)
  let created_ok = match r1 {
    domain.Created(_) -> true
    _                  -> false
  }
  assert created_ok
  assert id1 == 2

  let (r2, _, _) = store.process(domain.Get(1), n1, id1)
  let get_ok = match r2 {
    domain.Stored(c) -> c == "first"
    _                 -> false
  }
  assert get_ok
}

test "get missing note" {
  let (r, _, _) = store.process(domain.Get(99), [], 1)
  let ok = match r {
    domain.NotFound -> true
    _                -> false
  }
  assert ok
}

test "delete shrinks the list" {
  let (_, n1, id1) = store.process(domain.Create("a"), [], 1)
  let (_, n2, id2) = store.process(domain.Create("b"), n1, id1)
  let (r, n3, _)   = store.process(domain.Delete(1), n2, id2)
  let ok = match r {
    domain.Stored(_) -> true
    _                 -> false
  }
  assert ok
  assert list.length(n3) == 1
}
