# HTTP notes server.  Wires all the pieces together.
#
# Three structural notes:
#
#   1. `nursery { n -> ... }` is a syntactic cap binder.
#      `n` is not a value of type `Nursery`; the pre-typecheck
#      pass rewrites `n.spawn(task)` to `Spawn.spawn(task)`
#      tagged with the nursery's brand.  This means the spawn
#      call must appear lexically inside the nursery block;
#      we cannot factor the accept loop into a free function
#      that takes `n` as a parameter.
#
#   2. `Actor[t]` has no top-level default handler.  Every
#      fiber that calls `Actor.send` / `Actor.receive` must
#      run under its own `with_mailbox` (or `spawn_actor`): a
#      mailbox never crosses a spawn.  `main` neither sends
#      nor receives, so it installs none; each connection
#      fiber installs its own.
#
#   3. `Pid[t]` is region-branded to the nursery scope that
#      owns the Spawn handler.  We therefore spawn the two
#      actors *inside* the `nursery { n -> ... }` block and
#      use their pids from the same block.

import actor
import spawn
import loop
import net.tcp
import domain
import store
import persistence
import web

const PORT : Int = 8080

const LOG_PATH : String = "notes.log"

# Build the wire response for one HTTP request.  Hits the
# store via `store.ask` and logs mutating commands to the
# persistence actor before replying.
fn handle_request(
  raw: String,
  store_pid: Pid[store.StoreMsg],
  log_pid: Pid[persistence.Event]
) : String / Actor[store.StoreResp] {
  let reply = match web.parse_request(raw) {
    Err(msg) -> domain.ClientError(msg)
    Ok(req) -> match web.route(req) {
      Err(r) -> r
      Ok(command) -> {
        record_event(log_pid, command)
        store.ask(store_pid, command)
      }
    }
  }
  web.serialize_reply(reply)
}

fn record_event[m](log_pid: Pid[persistence.Event], c: domain.Command) : Unit / Actor[m] = match c {
  domain.Create(body) -> Actor.send(log_pid, persistence.Line("CREATE " ++ body))
  domain.Delete(id) -> Actor.send(log_pid, persistence.Line("DELETE #{id}"))
  _ -> ()
}

fn read_request(conn: Conn) : String / NetTcp = match NetTcp.recv(conn, 4096) {
  Ok(bytes) -> web.bytes_to_string(bytes)
  Err(_) -> ""
}

# Serve one connection end to end.  Spawns under the nursery
# in `main`; the calling fiber will install its own
# Actor[StoreResp] mailbox via `with_mailbox` so that the
# synchronous `store.ask` inside `handle_request` lands the
# reply on this fiber's mailbox.
#
# The row carries only that mailbox.  Sends to the store and
# to persistence go through it: a fiber never uses another
# fiber's mailbox.
fn serve_connection(
  conn: Conn,
  store_pid: Pid[store.StoreMsg],
  log_pid: Pid[persistence.Event]
) : Unit / NetTcp + Actor[store.StoreResp] + Cancel {
  let raw = read_request(conn)
  let wire = handle_request(raw, store_pid, log_pid)
  let _ = NetTcp.send(conn, web.string_to_bytes(wire))
  NetTcp.close(conn)
}

fn main() : Int / Stdout + NetTcp + File + Spawn + Cancel {
  persistence.reset_log(LOG_PATH)
  nursery { n ->
    let store_body: () -> Unit / Actor[store.StoreMsg] = () => store.store_loop([], 1)
    let log_body: () -> Unit / Actor[persistence.Event] + File =
      () => persistence.persistence_loop(LOG_PATH)
    let store_pid = spawn_actor(store_body)
    let log_pid = spawn_actor(log_body)
    match NetTcp.listen("0.0.0.0", PORT) {
      Err(msg) -> println("failed to start the server: " ++ msg)
      Ok(listener) -> {
        println("server listening on port #{PORT}")
        # Accept loop: each connection becomes a child
        # fiber spawned through the nursery cap `n`.  The
        # closure captures `n`, `store_pid`, and
        # `log_pid` from the surrounding nursery scope.
        forever(
          () => match NetTcp.accept(listener) {
            Err(_) -> ()
            Ok(conn) -> {
              # Each connection fiber installs its own
              # Actor[StoreResp] mailbox to receive the
              # store's reply on it (see `serve_connection`).
              let _ =
                n.spawn(() => with_mailbox(() => serve_connection(conn, store_pid, log_pid)))
              ()
            }
          }
        )
      }
    }
  }

  0
}
