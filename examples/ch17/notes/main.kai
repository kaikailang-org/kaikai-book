# HTTP notes server. Wires all the pieces:
# - The store runs as an actor with the in-memory list of
#   notes.
# - Persistence runs as another actor that writes the log.
# - The main loop accepts TCP connections, parses HTTP,
#   asks the store, writes the log if appropriate, and
#   replies.
#
# Each incoming connection is handled in its own fiber
# inside the nursery. The scheduler interleaves them
# cooperatively, and the blocked accept on the port yields
# until a new connection arrives.

import actor
import spawn
import fs.file
import domain
import store
import persistence
import http as http_lib
import net.tcp

const PORT : Int = 8080
const LOG_PATH : String = "notes.log"

fn handle_connection(
  conn: Conn,
  store_pid: Pid[store.StoreMsg],
  log_pid: Pid[persistence.Event],
) : Unit / NetTcp + Actor[store.StoreMsg] + Actor[store.StoreResp] + Actor[persistence.Event] + Cancel {
  let raw = read_request(conn)
  let resp = match http_lib.parse_request(raw) {
    Err(msg) -> domain.ClientError(msg)
    Ok(req)  -> match http_lib.route(req) {
      Err(r)       -> r
      Ok(command)  -> {
        record(log_pid, command)
        store.ask(store_pid, command)
      }
    }
  }
  NetTcp.send(conn, string_to_bytes(http_lib.serialize_response(resp)))
  NetTcp.close(conn)
}

fn read_request(conn: Conn) : String / NetTcp {
  match NetTcp.recv(conn, 4096) {
    Ok(bytes) -> bytes_to_string(bytes)
    Err(_)    -> ""
  }
}

fn record(log_pid: Pid[persistence.Event], c: domain.Command)
    : Unit / Actor[persistence.Event] {
  match c {
    domain.Create(body) -> Actor.send(log_pid, persistence.Line("CREATE " ++ body))
    domain.Delete(id)   -> Actor.send(log_pid, persistence.Line("DELETE #{id}"))
    _                    -> ()           # reads aren't logged
  }
}

fn accept_loop(
  listener: Listener,
  store_pid: Pid[store.StoreMsg],
  log_pid: Pid[persistence.Event],
) : Unit / NetTcp + Spawn + Cancel + Actor[store.StoreMsg] + Actor[store.StoreResp] + Actor[persistence.Event] {
  nursery { n ->
    forever_accept(n, listener, store_pid, log_pid)
  }
}

fn forever_accept(
  n: Nursery,
  listener: Listener,
  store_pid: Pid[store.StoreMsg],
  log_pid: Pid[persistence.Event],
) : Unit / NetTcp + Spawn + Cancel + Actor[store.StoreMsg] + Actor[store.StoreResp] + Actor[persistence.Event] {
  match NetTcp.accept(listener) {
    Err(_) -> ()           # listener closed, exit
    Ok(conn) -> {
      let _ = n.spawn(() => handle_connection(conn, store_pid, log_pid))
      forever_accept(n, listener, store_pid, log_pid)
    }
  }
}

fn main() : Unit / Console + NetTcp + File + Spawn + Cancel + Actor[store.StoreMsg] + Actor[store.StoreResp] + Actor[persistence.Event] {
  let store_pid = store.start()
  let log_pid   = persistence.start(LOG_PATH)

  match NetTcp.listen("0.0.0.0", PORT) {
    Err(msg) -> println("failed to start the server: " ++ msg)
    Ok(listener) -> {
      println("server listening on port #{PORT}")
      accept_loop(listener, store_pid, log_pid)
    }
  }
}
