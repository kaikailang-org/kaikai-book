# A hole can be the body of an arm: the match already covers
# every constructor and only the expression is missing.
# Useful when you know which case is pending but haven't yet
# decided how to handle it.

type Shape
  = Circle(Real)
  | Square(Real)
  | Triangle(Real, Real)

fn area(s: Shape) : Real {
  match s {
    Circle(r) -> 3.14 * r * r
    Square(l) -> l * l
    Triangle(b, h) -> ?triangle_formula
  }
}

fn main() : Unit / Stdout {
  println("circle 3 -> #{area(Circle(3.0))}")
  println("square 4 -> #{area(Square(4.0))}")
}
