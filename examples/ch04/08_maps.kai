# HashMap and HashSet: the two associative structures in the
# stdlib. The HashMap maps keys to values; the HashSet holds a
# set with no duplicates. Unlike records and lists, they are
# mutable: their writes yield the `Mutable` effect, which is
# masked when the structure is created and filled inside the
# same function.

import collections.hashmap as hashmap
import collections.hashset as hashset

# Count how many times each word appears in a list.
fn word_frequencies(words: [String]) : hashmap.HashMap[String, Int] {
  let m = hashmap.empty()
  words |! hashmap.put(m, ., unwrap_or(m[.], 0) + 1)
  m
}

fn main() : Unit / Stdout {
  let text = ["sun", "sea", "sun", "wind", "sea", "sun"]
  let m = word_frequencies(text)

  # Indexing m[key]: returns an Option, None when the key is absent.
  match m["sun"] {
    Some(n) -> Stdout.print("sun appears #{n} times")
    None -> Stdout.print("sun does not appear")
  }
  Stdout.print("distinct words: #{hashmap.size(m)}")

  # A HashSet drops duplicates on insertion.
  let seen = hashset.empty()
  text |! hashset.add(seen, .)
  Stdout.print("unique via set: #{hashset.size(seen)}")
}
