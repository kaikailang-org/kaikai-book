# The ledger's audit log. Each registered transaction gets
# written to an append-only file. In real accounting this
# isn't negotiable: transactions are never modified, only
# corrections are added. The file is evidence.
#
# As in chapter 17, isolating the writes in an actor lets
# the store keep responding while the disk is busy.

import actor
import fs.file

pub type Event = Line(String)

# Actor body. Appends each line and recurses to await the
# next event.
pub fn persistence_loop(path: String) : Unit / Actor[Event] + File = {
  match Actor.receive() {
    Line(s) -> {
      file_append(path, s ++ "\n")
      persistence_loop(path)
    }
  }
}

# Truncate the log file before the actor starts so each run
# begins with an empty log.
pub fn reset_log(path: String) : Unit / File = {
  file_write_file(path, "")
}
