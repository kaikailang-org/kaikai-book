# The ledger store. Actor that holds the list of accounts
# and the list of registered transactions.
#
# Three pieces:
#   - `process` is the pure logic (no effects), testable in
#     isolation.
#   - `store_loop` is the actor body that wraps `process` in
#     a loop over `Actor.receive()`.
#   - `ask` is the client-side synchronous wrapper.

import actor
import domain
import balance

# Store's protocol: a command plus the Pid that wants the
# reply. The store reads `Ask`, computes, sends back `Reply`.
pub type StoreMsg  = Ask(domain.Command, Pid[StoreResp])
pub type StoreResp = Reply(domain.Response)

# State of the store: known accounts, registered
# transactions, next-id counters.
pub type State = {
  accounts:         [domain.Account],
  transactions:     [domain.Transaction],
  next_account_id:  Int<AccountId>,
  next_tx_id:       Int<TransactionId>,
}

pub fn initial_state() : State = State {
  accounts:         [],
  transactions:     [],
  next_account_id:  1<AccountId>,
  next_tx_id:       1<TransactionId>,
}

# Pure logic. Takes the command and current state, returns
# the response and the new state. No effects.
pub fn process(c: domain.Command, s: State) : (domain.Response, State) = match c {
  CreateAccount(name) -> {
    let acc = domain.Account {
      id:      s.next_account_id,
      name:    name,
      balance: 0.0<USD>,
    }
    let s2 = State {
      accounts:         [acc, ...s.accounts],
      transactions:     s.transactions,
      next_account_id:  s.next_account_id + 1<AccountId>,
      next_tx_id:       s.next_tx_id,
    }
    (domain.AccountCreated(acc), s2)
  }
  Register(desc, movs) ->
    if not balance.is_balanced(movs) {
      (domain.UnbalancedError(
        "debits #{balance.total_debits(movs)}, credits #{balance.total_credits(movs)}"
      ), s)
    } else {
      match verify_accounts(movs, s.accounts) {
        Some(missing_id) -> (domain.UnknownAccount(missing_id), s)
        None -> {
          let tx = domain.Transaction {
            id:          s.next_tx_id,
            description: desc,
            movements:   movs,
          }
          let updated_accounts = apply_movs(s.accounts, movs)
          let s2 = State {
            accounts:         updated_accounts,
            transactions:     [tx, ...s.transactions],
            next_account_id:  s.next_account_id,
            next_tx_id:       s.next_tx_id + 1<TransactionId>,
          }
          (domain.TransactionRegistered(tx), s2)
        }
      }
    }
  QueryBalance(target_id) ->
    match find_account(s.accounts, target_id) {
      Some(c) -> (domain.CurrentBalance(c.balance), s)
      None    -> (domain.UnknownAccount(target_id), s)
    }
  ListAccounts ->
    (domain.Accounts(s.accounts), s)
}

# Verifies that every account mentioned in the movements
# exists. If one is missing, returns its id; otherwise None.
fn verify_accounts(ms: [domain.Movement], accounts: [domain.Account]) : Option[Int<AccountId>] = match ms {
  []           -> None
  [m, ...rest] -> {
    let target_id = id_of(m)
    match find_account(accounts, target_id) {
      None    -> Some(target_id)
      Some(_) -> verify_accounts(rest, accounts)
    }
  }
}

fn id_of(m: domain.Movement) : Int<AccountId> = match m {
  domain.Debit(target_id, _)  -> target_id
  domain.Credit(target_id, _) -> target_id
}

pub fn find_account(cs: [domain.Account], target_id: Int<AccountId>) : Option[domain.Account] = match cs {
  []           -> None
  [c, ...rest] -> if c.id == target_id { Some(c) } else { find_account(rest, target_id) }
}

# Apply the movements to each account's balance. Debits add,
# credits subtract. (Demo convention; in real accounting
# this depends on account type - asset vs liability - but
# the idea is the same.)
fn apply_movs(cs: [domain.Account], ms: [domain.Movement]) : [domain.Account] = match ms {
  []           -> cs
  [m, ...rest] -> apply_movs(apply_one(cs, m), rest)
}

# Manual recursion (not `list.map` + lambda) because kaikai
# 0.70 still trips when resolving qualified record types
# inside the spread sugar (`mod.Type { ...x, field: ... }`).
# We also write the updated record field-by-field instead of
# spreading.
fn apply_one(cs: [domain.Account], m: domain.Movement) : [domain.Account] = {
  let (target_id, delta) = delta_of(m)
  walk_accounts(cs, target_id, delta)
}

fn walk_accounts(cs: [domain.Account], target_id: Int<AccountId>, delta: Real<USD>) : [domain.Account] = match cs {
  []           -> []
  [c, ...rest] -> {
    let updated = if c.id == target_id {
      domain.Account { id: c.id, name: c.name, balance: c.balance + delta }
    } else {
      c
    }
    [updated, ...walk_accounts(rest, target_id, delta)]
  }
}

fn delta_of(m: domain.Movement) : (Int<AccountId>, Real<USD>) = match m {
  domain.Debit(target_id, n)  -> (target_id, n)
  domain.Credit(target_id, n) -> (target_id, 0.0<USD> - n)
}

# Actor body. Receives an `Ask`, calls `process`, sends the
# reply back, recurses with the new state. Carries both
# Actor[StoreMsg] (own mailbox, installed by spawn_actor)
# and Actor[StoreResp] (used by `Actor.send` only — the
# caller's fiber owns that mailbox).
pub fn store_loop(s: State) : Unit / Actor[StoreMsg] + Actor[StoreResp] = {
  match Actor.receive() {
    Ask(c, client) -> {
      let (resp, s2) = process(c, s)
      Actor.send(client, Reply(resp))
      store_loop(s2)
    }
  }
}

# Client-side helper. The caller must own an
# Actor[StoreResp] mailbox (the reply lands there).
pub fn ask(store: Pid[StoreMsg], c: domain.Command) : domain.Response / Actor[StoreMsg] + Actor[StoreResp] = {
  Actor.send(store, Ask(c, Actor.self()))
  match Actor.receive() {
    Reply(r) -> r
  }
}

# Tests against the pure logic, without actors.

test "creating an account adds it to state" {
  let (r, s2) = process(domain.CreateAccount("cash"), initial_state())
  let ok = match r {
    domain.AccountCreated(c) -> c.name == "cash"
    _                         -> false
  }
  assert ok
  assert list.length(s2.accounts) == 1
}

test "registering a transaction rejects an imbalance" {
  let s = State {
    accounts:         [domain.Account { id: 1<AccountId>, name: "a", balance: 0.0<USD> }],
    transactions:     [],
    next_account_id:  2<AccountId>,
    next_tx_id:       1<TransactionId>,
  }
  let movs = [domain.Debit(1<AccountId>, 100.0<USD>)]   # only debit, doesn't balance
  let (r, _) = process(domain.Register("test", movs), s)
  let ok = match r {
    domain.UnbalancedError(_) -> true
    _                          -> false
  }
  assert ok
}

test "registering a balanced transaction updates balances" {
  let s = State {
    accounts: [
      domain.Account { id: 1<AccountId>, name: "cash",  balance: 0.0<USD> },
      domain.Account { id: 2<AccountId>, name: "sales", balance: 0.0<USD> },
    ],
    transactions:     [],
    next_account_id:  3<AccountId>,
    next_tx_id:       1<TransactionId>,
  }
  let movs = [
    domain.Debit(1<AccountId>, 50.0<USD>),     # +50 to cash
    domain.Credit(2<AccountId>, 50.0<USD>),    # -50 to sales
  ]
  let (r, s2) = process(domain.Register("sale", movs), s)
  let ok = match r {
    domain.TransactionRegistered(_) -> true
    _                                -> false
  }
  assert ok
  let cash = find_account(s2.accounts, 1<AccountId>)
  let cash_balance = match cash {
    Some(c) -> c.balance
    None    -> 0.0<USD>
  }
  assert cash_balance == 50.0<USD>
}
