# Balance tests. Separate file to work around the kaikai 0.74.0
# typer bug (see store.kai).

import balance
import domain

test "balances with one debit and one credit" {
  let ms = [
    domain.Debit(1<domain.AccountId>, 100.0<domain.USD>),
    domain.Credit(2<domain.AccountId>, 100.0<domain.USD>),
  ]
  assert balance.is_balanced(ms)
}

test "doesn't balance when amounts differ" {
  let ms = [
    domain.Debit(1<domain.AccountId>, 100.0<domain.USD>),
    domain.Credit(2<domain.AccountId>, 90.0<domain.USD>),
  ]
  assert not balance.is_balanced(ms)
}

test "balances with multiple lines" {
  let ms = [
    domain.Debit(1<domain.AccountId>, 60.0<domain.USD>),
    domain.Debit(2<domain.AccountId>, 40.0<domain.USD>),
    domain.Credit(3<domain.AccountId>, 100.0<domain.USD>),
  ]
  assert balance.is_balanced(ms)
}
