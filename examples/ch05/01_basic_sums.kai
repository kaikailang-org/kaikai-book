# Sum types with `|`. Without payload ("empty" constructors)
# and with positional payload.

type Color = Red | Green | Blue

type Shape
  = Circle(Real)
  | Rectangle(Real, Real)
  | Triangle(Real, Real, Real)

fn area(s: Shape) : Real =
  match s {
    Circle(r)        -> 3.14159 * r * r
    Rectangle(w, h)  -> w * h
    Triangle(a, b, c) -> {
      let s = (a + b + c) / 2.0
      s
    }
  }

fn name(c: Color) : String =
  match c {
    Red   -> "red"
    Green -> "green"
    Blue  -> "blue"
  }

fn main() {
  println("color: #{name(Red)}, #{name(Green)}, #{name(Blue)}")
  let c = Circle(2.0)
  let r = Rectangle(3.0, 4.0)
  println("circle: area = #{area(c)}")
  println("rectangle: area = #{area(r)}")
}
