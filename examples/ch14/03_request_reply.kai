# Request/reply: the client sends the server a message carrying
# its own Pid so the server knows where to answer.
#
# Each side has its own message type: the client sends `Request`
# and receives `Reply`; the server receives `Request` and sends
# `Reply`. An actor's mailbox fixes what it receives; a Pid's
# type fixes what can be sent to it.
#
# `Actor.send` is polymorphic in the destination's type, so the
# server answers with a `Reply` without owning a `Reply` mailbox:
# the `Pid[Reply]` that rode inside the `Query` is enough.

import actor

type Request = Query(String, Pid[Reply])

type Reply = Answer(String)

fn server() : Unit / Actor[Request] + Stdout {
  match Actor.receive() {
    Query(q, client) -> {
      Stdout.print("server: got '#{q}'")
      Actor.send(client, Answer("reply to '#{q}'"))
      server()
    }
  }
}

fn main() : Unit / Stdout + Spawn + Cancel {
  with_mailbox {
    let s = spawn_actor(() => server())

    Actor.send(s, Query("two+two", Actor.self()))
    match Actor.receive() {
      Answer(r) -> Stdout.print("client: " ++ r)
    }

    Actor.send(s, Query("life", Actor.self()))
    match Actor.receive() {
      Answer(r) -> Stdout.print("client: " ++ r)
    }
  }
}
