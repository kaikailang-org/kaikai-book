# FizzBuzz.
#
# Sum types + pattern match. kaikai is expression-oriented:
# `if`, `match`, and blocks all produce a value.

type Tag
  = Both
  | Fizz
  | Buzz
  | Other(Int)

fn classify(n: Int) : Tag {
  if n % 15 == 0     { Both }
  else if n % 3 == 0 { Fizz }
  else if n % 5 == 0 { Buzz }
  else               { Other(n) }
}

fn label(c: Tag) : String {
  match c {
    Both     -> "FizzBuzz"
    Fizz     -> "Fizz"
    Buzz     -> "Buzz"
    Other(n) -> "#{n}"
  }
}

fn loop(i: Int, n: Int) : Unit / Stdout {
  # An `if` with no `else` yields an implicit `()` when the
  # condition is false — the usual way to say "do something or
  # stop the recursion".
  if i <= n {
    println(label(classify(i)))
    loop(i + 1, n)
  }
}

fn main() {
  loop(1, 15)
}
