# Listing 19.7 — examples/ch19/07_layout.kai
#[derive(Layout)]
type Packet = { magic: U32<be>, port: U16<be> }

fn main() : Unit / Stdout = {
  let bytes = Packet { magic: 0<be>, port: 0<be> }.to_bytes()
  match packet_from_bytes(bytes, 0) {
    Ok(p)  -> println("port #{p.value.port}")
    Err(m) -> println(m)
  }
}
