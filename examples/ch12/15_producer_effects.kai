# A producer can do more than `Yield`. The effects it performs are
# the `e` of `Gen[t, e]`, and they run where someone steps the
# generator, not where it was created: here the producer's
# `println` is served by main's handler.
#
# And you see the three the consumer asked for, not a fourth.

import gen.{Yield, generate, take_until, reduce}

fn noisy(n: Int) : Unit / Yield[Int] + Stdout = {
  println("  producing #{n}")
  Yield.yield(n)
  noisy(n + 1)
}

fn main() : Unit / Stdout = {
  println("the producer's effects run as you step it")
  let total = generate { noisy(1) }
    |> take_until(n => n >= 3)
    |> reduce((a, b) => a + b)
  println("total = #{total}")
}
