{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.envrc)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.envrc)",
      "Read(**/.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/deny-env-read.sh",
            "statusMessage": "Revisando que el comando no toque archivos de entorno"
          }
        ]
      }
    ]
  }
}
